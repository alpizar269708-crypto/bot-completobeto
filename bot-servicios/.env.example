# MongoDB Atlas
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/botservicios?retryWrites=true&w=majority

# Número del dueño/usuario que controla activación y cuentas nuevas.
# Sólo dígitos con código de país. Ejemplo México: 5255XXXXXXXX
OWNER_PHONE=52XXXXXXXXXX

# Número que WhatsApp usará para pedir el código de vinculación la primera vez.
# Normalmente es el mismo número del bot.
PAIRING_PHONE=52XXXXXXXXXX

# Opcionales: multiplicador mostrado en vercuenta para los recuentos de 250 y 35.
MULTIPLIER_250=20
MULTIPLIER_35=20

LOG_LEVEL=info
